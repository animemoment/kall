<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Тесты исключены из сборки игры: каталог tests/ содержит файлы, написанные под
    API, которого нет/который переименован (FarmController.ResolveFor, ShadowCaster
    .* и т.д.) — 470 ошибок компиляции, не относящихся к игре. Игра собирается без
    них; тесты восстанавливаются отдельной задачей (см. _plan/REGRESSIONS.md).

    Вернуть в сборку: удалить эту группу или собрать тесты отдельным csproj,
    который ссылается на Game.csproj.
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Include="tests/**" />
    <Compile Include="tests/TestWorldPathfinder.cs" />
    <Compile Include="tests/TestPathBounds.cs" />
    <Compile Include="tests/TestPathCorners.cs" />
    <Compile Include="tests/TestPathHeuristic.cs" />
    <Compile Include="tests/TestWorldCostCache.cs" />
    <Compile Include="tests/TestWorldWallCost.cs" />
    <Compile Include="tests/TestPureWorldGen.cs" />
    <Compile Remove="_test_puti/**" />
    <None Include="_test_puti/**" />
    <Compile Remove="_test_jobs/**" />
    <None Include="_test_jobs/**" />
    <Compile Remove="_test_soil/**" />
    <None Include="_test_soil/**" />
    <Compile Remove="_test_render/**" />
    <None Include="_test_render/**" />
    <!-- Стенд поиска пути (консольный, гоняет исходники из src/): в игру не компилируется. -->
    <Compile Remove="_bench/**" />
    <None Include="_bench/**" />
  </ItemGroup>
</Project>
