extends SceneTree

# 28-09 / 28-02 / 28-06: мышь HUD, проба клетки и две независимые подсказки.
# 28-09 — панель ресурсов (AmountOfResources) больше не переводится в Stop: панель,
#         которая рисует только текст и иконки, прозрачна для мыши, а панель с кнопкой,
#         кнопки, списки и скроллы — перехватывают клик.
# 28-02 — проба клетки подключается идемпотентно из _Ready, из Setup и повтором из
#         _Process, поэтому порядок создания PlayerInteractionManager больше не важен.
# 28-06 — влажность и плодородие живут в двух отдельных слоях подсказки и не гасят
#         друг друга в одном кадре.
# Запуск: godot --headless --path . --script res://tests/run_hud_mouse_probe.gd

func _init():
	var t = load("res://tests/TestHudMouseProbe.cs").new()
	quit(0 if t.Run() else 1)